# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=3000

# Browser origin of the Vite PWA (HTTPS in local dev).
FRONTEND_ORIGIN=https://localhost:5173

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql://password_manager:password_manager@localhost:5432/password_manager

# HS256 secrets for session JWTs (min 32 characters). Replace before any shared deploy.
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-32b
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32
